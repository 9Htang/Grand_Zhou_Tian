[gd_resource type="Resource" script_class="CardData" load_steps=3 format=3]

[ext_resource type="Script" path="res://resources/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://systems/vm/ir/effect_node.gd" id="2_node"]

[sub_resource type="Resource" id="sub_pathway_up"]
script = ExtResource("2_node")
id = "n1"
