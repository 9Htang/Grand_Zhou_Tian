# ============================================================
# 大周天 — EventResult (事件结果 DTO)
# ============================================================
# 纯数据载体 — 事件选择执行后返回的结果
# ============================================================
class_name EventResult
extends RefCounted


## 此次选择是否执行成功
var success: bool = true

## 结果描述文字，展示在事件界面结果区域
var text: String = ""

## 已执行的效果列表，格式: ["effect:arg1:arg2", ...]
var effects: Array[String] = []
